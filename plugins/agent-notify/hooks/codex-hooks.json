{
  "hooks": {
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/src/notify.js\" codex", "async": true, "timeout": 30 }] }
    ],
    "PermissionRequest": [
      { "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/src/notify.js\" codex", "async": true, "timeout": 30 }] }
    ],
    "PreToolUse": [
      {
        "matcher": "request_user_input",
        "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/src/notify.js\" codex", "async": true, "timeout": 30 }]
      }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/src/notify.js\" codex", "async": true, "timeout": 30 }] }
    ]
  }
}
